{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",

    // ⚡
    "moduleResolution": "bundler",
    "esModuleInterop": true,

    // 🍏
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    // 📦
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",

    // 🛡️
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
